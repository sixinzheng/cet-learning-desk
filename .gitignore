# Local user data and credentials
/data/
.env
.env.*
*.clixml
*.jks
*.keystore
*.p12
*.pem
*.key

# Python caches and locally installed dependencies
__pycache__/
*.py[cod]
/.deps/
/.runtime_deps/
/.venv/
/.test-venv/
/venv/

# JavaScript, Rust and desktop build output
node_modules/
/desktop/.python-build-deps/
