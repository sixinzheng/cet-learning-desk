/desktop/pyinstaller-build/
/desktop/pyinstaller-dist/
/desktop/tauri-temp/
/desktop/src-tauri/target/
/desktop/src-tauri/binaries/*.exe
/dist/

# Android-generated sources, tools and build output
/android/.gradle/
/android/.tools/
/android/local.properties
/android/app/build*/
/android/app/src/main/python/
/android/app/src/main/assets/app_resources/
*.apk
*.aab
*.idsig

# Local backups, browser profiles and QA artifacts
/.backup-*/
/_edge_*/
/browser-artifacts/
/templates/.impeccable/
/home-refinement-artifacts/
/.impeccable/
/.impeccable-detector-runtime/

# Logs and transient files
*.log
*.tmp
*.bak
*.db-wal
*.db-shm
.coverage
.pytest_cache/

